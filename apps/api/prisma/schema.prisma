// use prisma-next

enum Badge {
  READER
}

model User {
  id            String         @id @default(uuid())
  supabaseId    String         @unique
  email         String         @unique
  username      String?        @unique
  displayName   String?
  profileImage  String?
  bannerImage   String?
  description   String?
  badges        Badge[]
  locale        String         @default("es")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())

  followers        Follow[]          @relation("following")
  following        Follow[]          @relation("follower")
  comments         Comment[]
  commentLikes     CommentLike[]
  commentReactions CommentReaction[]
  commentReports   CommentReport[]
  favorites        Favorite[]
  notifications    Notification[]    @relation("UserNotifications")
  sentNotifications Notification[]   @relation("ActorNotifications")

  @@index([supabaseId])
  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  mangaId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@map("favorites")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  mangaId   String?
  chapterId String?
  parentId  String?
  content   String
  imageUrl  String?
  isSpoiler Boolean  @default(false)
  isHidden  Boolean  @default(false)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("Replies")
  likes     CommentLike[]
  reactions CommentReaction[]
  reports   CommentReport[]

  @@index([mangaId])
  @@index([chapterId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String  @id @default(uuid())
  commentId String
  userId    String
  value     Int     // +1 = like, -1 = dislike

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model CommentReaction {
  id        String @id @default(uuid())
  commentId String
  userId    String
  emoji     String // e.g. "🔥", "❤️", "😂"

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@map("comment_reactions")
}

model CommentReport {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reports")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String   // e.g. "MENTION", "REPLY"
  entityId  String   // e.g. commentId
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actorId])
  @@map("notifications")
}

// use prisma-next

model User {
  id            String         @id @default(uuid())
  supabaseId    String         @unique
  email         String         @unique
  displayName   String?
  locale        String         @default("es")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())

  @@index([supabaseId])
  @@map("users")
}
